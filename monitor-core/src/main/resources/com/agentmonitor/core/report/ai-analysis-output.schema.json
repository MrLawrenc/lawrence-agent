{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-monitor:ai-analysis-output:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "usable",
            "partial",
            "insufficient"
          ]
        },
        "captureComplete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "analysisReady": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "populationStatisticsAllowed": {
          "const": false
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "verdict",
        "captureComplete",
        "analysisReady",
        "populationStatisticsAllowed",
        "issues"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "jsonPointer": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                },
                "traceId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "method": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {},
                "unit": {
                  "enum": [
                    "nanoseconds",
                    "milliseconds",
                    "count",
                    "text",
                    "boolean",
                    "percent",
                    "ratio",
                    "per_second",
                    "bytes",
                    "mebibytes"
                  ]
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "evidenceId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "file",
                "jsonPointer",
                "traceId",
                "method",
                "value",
                "unit"
              ]
            }
          },
          "hypothesis": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "missingEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "baseline": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "type": "string",
                "minLength": 1
              },
              "metrics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "acceptance": {
                "type": "string",
                "minLength": 1
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "baseline",
              "change",
              "metrics",
              "acceptance",
              "risks"
            ]
          }
        },
        "required": [
          "id",
          "priority",
          "title",
          "observation",
          "evidence",
          "hypothesis",
          "confidence",
          "missingEvidence",
          "recommendation",
          "validation"
        ]
      }
    },
    "nextMeasurements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "quality",
    "findings",
    "nextMeasurements"
  ]
}
