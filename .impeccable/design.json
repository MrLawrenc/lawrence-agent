  "narrative": {
    "northStar": "Desktop investigation workbench",
    "overview": "Agent Monitor uses a continuous white evidence workspace, a pale green-gray navigation rail, and deep teal for actions and selection. System typography supports Chinese labels alongside JVM identifiers. The visual character is quiet, precise, and compact enough for sustained investigation.\n\nThe workbench keeps navigation, target identity, and capture controls stable while the evidence changes. Flat surfaces and restrained separators provide hierarchy; imagery and decorative animation are absent. This records the implemented native desktop system, not a web or mobile theme.",
    "keyCharacteristics": [
      "Persistent task navigation with retained page state.",
      "Neutral evidence surfaces with teal interaction states.",
      "Native controls, visible keyboard focus, and compact data typography.",
      "Inline evidence, editors, and results within the main workspace."
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "Use teal for actions and selection; use green, amber, and red for runtime meaning. Keep a text label with every status.",
        "section": "colors"
      },
      {
        "name": "The Evidence Type Rule",
        "body": "Use system type for navigation and tables, and monospace for code and raw evidence. Keep units and measurement meaning visible.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep the evidence workspace flat. Separate regions with spacing, tonal surfaces, or a single border; do not recreate the former nested rounded panel grid.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the fixed navigation rail and persistent target and capture controls across workbench pages.",
      "Do use the documented semantic colors and native System typography for new desktop controls.",
